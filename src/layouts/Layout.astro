---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const { 
  title = "Fair Rent Calculator — Mathematically Split & Evaluate Rent", 
  description = "Solve roommate conflicts and check rental pricing. Calibrate your screen size to trace layout blueprints, divide rent based on customized room amenity weightings, and evaluate local listings.",
  canonicalUrl = "https://fairrentcalc.com"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="FairCalc" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Theme init: prevents flash of wrong theme -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
        var locale = localStorage.getItem('locale');
        if (locale) {
          document.documentElement.setAttribute('lang', locale);
        }
      })();
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://fairrentcalc.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fairrentcalc - Mathematically Split & Evaluate Rent" />
    <meta property="og:site_name" content="Fairrentcalc" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://fairrentcalc.com/og-image.png" />
    <meta name="twitter:image:alt" content="Fairrentcalc - Mathematically Split & Evaluate Rent" />
    
    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data for Search Engine optimization -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Fairrentcalc",
        "alternateName": ["Fair Rent Calculator", "FairRentCalc", "Rent Split Calculator"],
        "url": "https://fairrentcalc.com",
        "description": "An interactive rent split calculator that divides roommate rent shares mathematically based on room square footage, private bathrooms, balconies, walk-in closets, and custom amenity weight sliders. Also features a credit-card-based screen calibrator for measuring floor plan blueprints and a listing evaluator for checking rent affordability.",
        "applicationCategory": "FinancialApplication",
        "operatingSystem": "All",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Rent split calculator by square footage",
          "Rent split calculator based on room size",
          "Apartment rent split calculator",
          "Rent split calculator by room",
          "Custom amenity weight sliders",
          "Credit card screen calibration",
          "Blueprint scale measurement",
          "Listing affordability evaluator",
          "50/30/20 budget breakdown"
        ],
        "keywords": "fairrentcalc, rent split calculator, rent split calculator by square footage, rent split calculator based on room size, apartment rent split calculator, rent split calculator square footage, rent split calculator by room, detailed rent split calculator, rent split calculator roommates"
      }
    </script>

    <!-- FAQPage Structured Data for rich results -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How to split rent by square footage calculator?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "To split rent by square footage, enter each roommate's room size in the Rent Split Calculator. The tool divides the base rent proportionally based on how many square feet each room occupies. A 180 sq ft master bedroom will naturally cost more than a 100 sq ft secondary room. You can also layer on amenity premiums — such as private bathrooms, balconies, and walk-in closets — using the weight sliders to get a fully customized and mathematically fair breakdown."
            }
          },
          {
            "@type": "Question",
            "name": "How to split rent based on income calculator?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fairrentcalc's Listing Evaluator includes an income-based affordability check. Enter your combined group gross monthly income and the listed rent. The tool applies the 30% rule to calculate safe, stretched, and high-risk rent thresholds. It also provides a 50/30/20 monthly budget breakdown so your group can see exactly how rent impacts essentials, wants, and savings. This helps you decide whether a listing fits your income before you commit."
            }
          },
          {
            "@type": "Question",
            "name": "How to split rent with roommates calculator?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Use the Rent Split Calculator to add each roommate as a separate room entry. Input the room name, square footage, and toggle which amenities apply (private bathroom, balcony, closet, windows). Adjust the global amenity weight sliders to set premium percentages. The calculator updates in real time, showing each roommate's share as a visual bar chart and in a detailed breakdown table. No login or account is needed — just open the tool and start calculating."
            }
          },
          {
            "@type": "Question",
            "name": "Does rent increase 10% or 5%?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Rent increases vary by market, location, and landlord policy. In many U.S. markets, annual rent increases typically range from 3% to 10%, with 5% being a common midpoint and 10% occurring in high-demand areas. Some jurisdictions cap annual increases (for example, California's AB 1482 limits most increases to 5% plus local inflation, up to 10%). Fairrentcalc's Listing Evaluator helps you assess whether a listed rent — including any recent increase — is fair compared to local square footage rates and your income."
            }
          },
          {
            "@type": "Question",
            "name": "How to divide rent fairly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The fairest way to divide rent is to base each roommate's share on the actual space and features they get. Equal splitting ignores that a master bedroom with a private bathroom is objectively more valuable than a small room with shared facilities. Fairrentcalc divides rent by square footage and lets you add custom amenity premiums using adjustable weight sliders. This means the person with the biggest room and the most perks pays proportionally more — and every roommate can see the exact math behind their share in the detailed breakdown table."
            }
          },
          {
            "@type": "Question",
            "name": "How can I calculate rent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "To calculate rent, start with the total monthly rent and the square footage of each room. Divide each room's square footage by the total square footage to get a size ratio, then multiply the base rent by that ratio. Add any amenity premiums for features like private bathrooms or balconies. Fairrentcalc automates this entire process — just enter your total rent, room sizes, and feature toggles, and the Rent Split Calculator instantly shows each roommate's exact share with a visual chart and detailed table."
            }
          }
        ]
      }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CM8TP80P6B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CM8TP80P6B');
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-canvas-soft text-ink font-sans antialiased selection:bg-ink selection:text-canvas">
    <!-- Skip navigation link for accessibility compliance -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-canvas focus:text-ink focus:border focus:border-hairline focus:rounded-sm focus:shadow-level-2 focus:outline-none">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-grow relative w-full max-w-[1400px] mx-auto px-4 md:px-8 focus:outline-none">
      <div class="mesh-gradient-bg"></div>
      <slot />
    </main>

    <Footer />

