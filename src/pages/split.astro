---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Rent Split Calculator — Split Rent by Square Footage & Room Size | Fairrentcalc"
  description="Use this rent split calculator to divide roommate rent by square footage, room size, and custom amenity weights. The detailed rent split calculator roommates trust for fair, math-based rent division."
  canonicalUrl="https://fairrentcalc.com/split"
>
  <div class="py-12">
    <!-- Header -->
    <div class="mb-12">
      <span class="font-mono text-xs font-semibold text-link uppercase tracking-wider" data-i18n="split.badge">Step 1 of 2</span>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-display-lg text-ink mt-2" data-i18n="split.title">
        Divide rent amongst roommates.
      </h1>
      <p class="mt-3 text-body max-w-2xl text-base" data-i18n="split.subtitle">
        Adjust weights for room features, add rooms, and adjust dimensions. Calculations update in real-time.
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Left Columns: Controls & Rooms -->
      <div class="col-span-2 flex flex-col gap-8">
        
        <!-- Global Parameters Card -->
        <div class="bg-canvas border border-hairline rounded-md p-6 shadow-level-2">
          <h2 class="text-lg font-semibold tracking-display-md text-ink mb-6 pb-3 border-b border-hairline" data-i18n="split.params">
            1. Global Rent Parameters
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Total Rent -->
            <div>
              <label for="total-rent" class="block text-xs font-mono font-medium text-hairline-strong uppercase mb-2" data-i18n="split.rent.label">
                Total Monthly Rent
              </label>
              <div class="relative rounded-sm shadow-level-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-mute font-mono text-sm pointer-events-none">$</span>
                <input 
                  type="number" 
                  id="total-rent" 
                  name="total-rent" 
                  value="3000" 
                  min="1" 
                  class="w-full h-10 pl-8 pr-4 border border-hairline rounded-sm text-sm text-ink focus-visible-vercel bg-canvas tabular-nums"
                  placeholder="3000"
                />
              </div>
            </div>

            <!-- Currency Indicator or Info -->
            <div class="flex items-center">
              <div class="p-3 bg-canvas-soft-2 border border-hairline rounded-sm text-xs text-body leading-relaxed flex items-start gap-2.5">
                <svg class="w-4 h-4 text-link shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>
                  Adjust the total monthly rent, then tweak amenity weight percentages below to allocate premiums.
                </span>
              </div>
            </div>
          </div>

          <!-- Feature Weightings -->
          <div class="mt-8">
              <span class="block text-xs font-mono font-medium text-hairline-strong uppercase mb-4" data-i18n="split.amenities">
              Amenity Premiums (% of Total Rent)
            </span>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              <!-- Private Bath -->
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-ink" data-i18n="split.bath">Private Bathroom</span>
                  <span id="label-weight-bath" class="font-mono text-link">15%</span>
                </div>
                <input 
                  type="range" 
                  id="weight-bath" 
                  min="0" 
                  max="30" 
                  value="15" 
                  class="w-full accent-ink focus-visible-vercel" 
                  aria-label="Private Bathroom weight slider"
                />
              </div>

              <!-- Private Balcony -->
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-ink" data-i18n="split.balcony">Private Balcony</span>
                  <span id="label-weight-balcony" class="font-mono text-link">5%</span>
                </div>
                <input 
                  type="range" 
                  id="weight-balcony" 
                  min="0" 
                  max="15" 
                  value="5" 
                  class="w-full accent-ink focus-visible-vercel" 
                  aria-label="Private Balcony weight slider"
                />
              </div>

              <!-- Walk-in Closet -->
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-ink" data-i18n="split.closet">Walk-in Closet</span>
                  <span id="label-weight-closet" class="font-mono text-link">5%</span>
                </div>
                <input 
                  type="range" 
                  id="weight-closet" 
                  min="0" 
                  max="15" 
                  value="5" 
                  class="w-full accent-ink focus-visible-vercel" 
                  aria-label="Walk-in Closet weight slider"
                />
              </div>

              <!-- Window / Sunlight -->
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-ink" data-i18n="split.window">Large Windows</span>
                  <span id="label-weight-window" class="font-mono text-link">3%</span>
                </div>
                <input 
                  type="range" 
                  id="weight-window" 
                  min="0" 
                  max="10" 
                  value="3" 
                  class="w-full accent-ink focus-visible-vercel" 
                  aria-label="Large Windows weight slider"
                />
              </div>

            </div>
          </div>
        </div>

        <!-- Room List Container -->
        <div class="bg-canvas border border-hairline rounded-md p-6 shadow-level-2">
          <div class="flex items-center justify-between pb-3 border-b border-hairline mb-6">
            <h2 class="text-lg font-semibold tracking-display-md text-ink" data-i18n="split.rooms">
              2. Bedroom Configuration
            </h2>
            <button 
              id="add-room-btn" 
              class="h-8 px-4 flex items-center justify-center bg-primary hover:bg-ink text-on-primary text-xs font-semibold rounded-sm transition-all focus-visible-vercel shadow-level-1"
              data-i18n="split.add.room"
            >
              + Add Room
            </button>
          </div>

          <!-- Room Cards List -->
          <div id="rooms-list" class="space-y-4">
            <!-- Room elements will be injected here by Javascript -->
          </div>
        </div>

      </div>

      <!-- Right Column: Live Calculations & Breakdown -->
      <div class="col-span-1 flex flex-col gap-8 sticky top-24">
        
        <!-- Results Summary Card -->
        <div class="bg-canvas border border-hairline rounded-md p-6 shadow-level-3">
          <h2 class="text-lg font-semibold tracking-display-md text-ink mb-6 pb-3 border-b border-hairline" data-i18n="split.results">
            Rent Distribution
          </h2>

          <!-- Visual Bar Chart for Shares -->
          <div class="space-y-4 mb-8">
            <span class="block text-xs font-mono font-medium text-hairline-strong uppercase" data-i18n="split.chart">
              Rent Distribution Chart
            </span>
            <div id="chart-bars-container" class="space-y-3">
              <!-- Visual bars will be injected here -->
            </div>
          </div>

          <!-- Total Rent Summary Math Box -->
          <div class="bg-canvas-soft border border-hairline rounded-sm p-4 mb-6 space-y-2">
            <div class="flex justify-between text-xs text-body">
              <span data-i18n="split.total.rent">Total Rent to split</span>
              <span id="summary-total-rent" class="font-mono font-semibold text-ink">$3,000.00</span>
            </div>
            <div class="flex justify-between text-xs text-body">
              <span data-i18n="split.base.rent">Allocated base rent</span>
              <span id="summary-base-rent" class="font-mono text-ink">$2,160.00</span>
            </div>
            <div class="flex justify-between text-xs text-body">
              <span data-i18n="split.premium.rent">Allocated amenity premiums</span>
              <span id="summary-premium-rent" class="font-mono text-ink">$840.00</span>
            </div>
            <div class="h-[1px] bg-hairline my-2"></div>
            <div class="flex justify-between text-sm font-semibold">
              <span class="text-ink" data-i18n="split.checksum">Sum of Roommate Splits</span>
              <span id="summary-checksum" class="font-mono text-link">$3,000.00</span>
            </div>
          </div>

          <!-- CTA to physical calibrator -->
          <div class="text-center pt-2">
            <p class="text-xs text-mute leading-relaxed mb-4">
              Unsure about the exact dimensions? Calibrate your screen using a credit card to measure your layout blueprints.
            </p>
            <a 
              href="/calibrate" 
              class="w-full h-10 border border-hairline hover:bg-canvas-soft text-ink text-sm font-semibold rounded-sm shadow-level-1 transition-all flex items-center justify-center gap-2 focus-visible-vercel"
              data-i18n="split.calibrate.cta"
            >
              <svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Calibrate Blueprint Scale
            </a>
          </div>

        </div>

      </div>

    </div>

    <!-- Tabular Breakdown Row -->
    <div class="mt-12 bg-canvas border border-hairline rounded-md p-6 shadow-level-2">
      <h2 class="text-lg font-semibold tracking-display-md text-ink mb-6 pb-3 border-b border-hairline" data-i18n="split.table.title">
        Detailed Mathematical Split Table
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-hairline bg-canvas-soft-2 font-mono text-[10px] text-hairline-strong uppercase">
              <th class="px-6 py-3 font-semibold" data-i18n="split.table.room">Room / Roommate</th>
              <th class="px-6 py-3 font-semibold text-right" data-i18n="split.table.size">Size (sq ft)</th>
              <th class="px-6 py-3 font-semibold text-right" data-i18n="split.table.sizePercent">Size %</th>
              <th class="px-6 py-3 font-semibold text-right" data-i18n="split.table.base">Base Share</th>
              <th class="px-6 py-3 font-semibold text-right" data-i18n="split.table.surcharge">Amenities Surcharge</th>
              <th class="px-6 py-3 font-semibold text-right text-link" data-i18n="split.table.total">Total Rent Split</th>
            </tr>
          </thead>
          <tbody id="detailed-table-body" class="divide-y divide-hairline text-sm tabular-nums">
            <!-- Table content will be injected by JavaScript -->
          </tbody>
        </table>
      </div>
    </div>

  </div>
</Layout>

<script>
  interface Room {
    id: string;
    name: string;
    size: number;
    hasBath: boolean;
    hasBalcony: boolean;
    hasCloset: boolean;
    hasWindow: boolean;
  }

  // Initial Rooms state
  let rooms: Room[] = [
    { id: '1', name: 'Master Room (Alice)', size: 180, hasBath: true, hasBalcony: true, hasCloset: true, hasWindow: true },
    { id: '2', name: 'Second Room (Bob)', size: 140, hasBath: false, hasBalcony: false, hasCloset: true, hasWindow: true },
    { id: '3', name: 'Third Room (Charlie)', size: 120, hasBath: false, hasBalcony: false, hasCloset: false, hasWindow: true },
    { id: '4', name: 'Small Room (David)', size: 100, hasBath: false, hasBalcony: false, hasCloset: false, hasWindow: false },
  ];

  // DOM elements
  const totalRentInput = document.getElementById('total-rent') as HTMLInputElement;
  const weightBathInput = document.getElementById('weight-bath') as HTMLInputElement;
  const weightBalconyInput = document.getElementById('weight-balcony') as HTMLInputElement;
  const weightClosetInput = document.getElementById('weight-closet') as HTMLInputElement;
  const weightWindowInput = document.getElementById('weight-window') as HTMLInputElement;

  const labelBath = document.getElementById('label-weight-bath') as HTMLSpanElement;
  const labelBalcony = document.getElementById('label-weight-balcony') as HTMLSpanElement;
  const labelCloset = document.getElementById('label-weight-closet') as HTMLSpanElement;
  const labelWindow = document.getElementById('label-weight-window') as HTMLSpanElement;

  const roomsListContainer = document.getElementById('rooms-list') as HTMLDivElement;
  const detailedTableBody = document.getElementById('detailed-table-body') as HTMLTableSectionElement;
  const chartContainer = document.getElementById('chart-bars-container') as HTMLDivElement;

  const summaryTotalRent = document.getElementById('summary-total-rent') as HTMLSpanElement;
  const summaryBaseRent = document.getElementById('summary-base-rent') as HTMLSpanElement;
  const summaryPremiumRent = document.getElementById('summary-premium-rent') as HTMLSpanElement;
  const summaryChecksum = document.getElementById('summary-checksum') as HTMLSpanElement;
  const addRoomBtn = document.getElementById('add-room-btn') as HTMLButtonElement;

  // Colors for visualization bars â€” uses static .bar-color-N classes defined in global.css
  // (avoids Tailwind v4 dynamic class detection issue with dynamically concatenated strings)
  const chartColorCount = 5;

  function renderRooms() {
    roomsListContainer.innerHTML = '';
    rooms.forEach((room, index) => {
      const roomCard = document.createElement('div');
      roomCard.className = 'p-5 bg-canvas-soft border border-hairline rounded-sm space-y-4 hover:shadow-level-2 transition-all relative group';
      
      roomCard.innerHTML = `
        <div class="flex items-center justify-between gap-4">
          <input 
            type="text" 
            value="${room.name}" 
            data-room-id="${room.id}" 
            data-field="name" 
            class="room-name-input bg-transparent border-b border-transparent hover:border-hairline-strong focus:border-link text-sm font-semibold text-ink focus:outline-none transition-all pb-0.5" 
            aria-label="Room name"
          />
          <button 
            data-room-id="${room.id}" 
            class="delete-room-btn text-mute hover:text-error text-xs font-semibold focus-visible-vercel rounded-sm px-1.5 py-0.5 transition-colors absolute top-4 right-4"
            aria-label="Delete room"
            data-i18n="split.room.remove"
          >
            Remove
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Room Size -->
          <div>
            <label class="block text-[11px] font-mono text-hairline-strong uppercase mb-1.5" data-i18n="split.room.size">
              Room Size (sq ft)
            </label>
            <input 
              type="number" 
              value="${room.size}" 
              data-room-id="${room.id}" 
              data-field="size" 
              min="1" 
              class="room-size-input w-full h-8 px-2 border border-hairline rounded-sm text-xs font-mono text-ink focus-visible-vercel bg-canvas tabular-nums"
              aria-label="Room size in square feet"
            />
          </div>

          <!-- Room Amenities toggles -->
          <div>
            <label class="block text-[11px] font-mono text-hairline-strong uppercase mb-2" data-i18n="split.room.features">
              Features
            </label>
            <div class="grid grid-cols-2 gap-2">
              <label class="flex items-center gap-1.5 text-xs text-body cursor-pointer">
                <input 
                  type="checkbox" 
                  ${room.hasBath ? 'checked' : ''} 
                  data-room-id="${room.id}" 
                  data-field="hasBath" 
                  class="room-checkbox accent-ink rounded-sm focus-visible-vercel" 
                />
                <span data-i18n="split.room.bath">Bath</span>
              </label>
              <label class="flex items-center gap-1.5 text-xs text-body cursor-pointer">
                <input 
                  type="checkbox" 
                  ${room.hasBalcony ? 'checked' : ''} 
                  data-room-id="${room.id}" 
                  data-field="hasBalcony" 
                  class="room-checkbox accent-ink rounded-sm focus-visible-vercel" 
                />
                <span data-i18n="split.room.balcony">Balcony</span>
              </label>
              <label class="flex items-center gap-1.5 text-xs text-body cursor-pointer">
                <input 
                  type="checkbox" 
                  ${room.hasCloset ? 'checked' : ''} 
                  data-room-id="${room.id}" 
                  data-field="hasCloset" 
                  class="room-checkbox accent-ink rounded-sm focus-visible-vercel" 
                />
                <span data-i18n="split.room.closet">Closet</span>
              </label>
              <label class="flex items-center gap-1.5 text-xs text-body cursor-pointer">
                <input 
                  type="checkbox" 
                  ${room.hasWindow ? 'checked' : ''} 
                  data-room-id="${room.id}" 
                  data-field="hasWindow" 
                  class="room-checkbox accent-ink rounded-sm focus-visible-vercel" 
                />
                <span data-i18n="split.room.window">Window</span>
              </label>
            </div>
          </div>
        </div>
      `;
      roomsListContainer.appendChild(roomCard);
    });

    // Add listeners to input alterations
    document.querySelectorAll('.room-name-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const roomId = target.getAttribute('data-room-id');
        const room = rooms.find(r => r.id === roomId);
        if (room) {
          room.name = target.value;
          calculateSplits();
        }
      });
    });

    document.querySelectorAll('.room-size-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const roomId = target.getAttribute('data-room-id');
        const room = rooms.find(r => r.id === roomId);
        if (room) {
          room.size = Math.max(1, Number(target.value) || 0);
          calculateSplits();
        }
      });
    });

    document.querySelectorAll('.room-checkbox').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const roomId = target.getAttribute('data-room-id');
        const field = target.getAttribute('data-field') as 'hasBath' | 'hasBalcony' | 'hasCloset' | 'hasWindow';
        const room = rooms.find(r => r.id === roomId);
        if (room && field) {
          room[field] = target.checked;
          calculateSplits();
        }
      });
    });

    document.querySelectorAll('.delete-room-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLButtonElement;
        const roomId = target.getAttribute('data-room-id');
        rooms = rooms.filter(r => r.id !== roomId);
        renderRooms();
        calculateSplits();
      });
    });

    if (typeof (window as any).applyTranslations === 'function') {
      (window as any).applyTranslations();
    }
  }

  function calculateSplits() {
    const totalRent = Math.max(0, Number(totalRentInput.value) || 0);
    const weightBath = (Number(weightBathInput.value) || 0) / 100 * totalRent;
    const weightBalcony = (Number(weightBalconyInput.value) || 0) / 100 * totalRent;
    const weightCloset = (Number(weightClosetInput.value) || 0) / 100 * totalRent;
    const weightWindow = (Number(weightWindowInput.value) || 0) / 100 * totalRent;

    // Update labels
    labelBath.textContent = `${weightBathInput.value}%`;
    labelBalcony.textContent = `${weightBalconyInput.value}%`;
    labelCloset.textContent = `${weightClosetInput.value}%`;
    labelWindow.textContent = `${weightWindowInput.value}%`;

    // 1. Calculate features premium surcharge per room and in total
    let totalPremiumsSum = 0;
    const roomPremiums = rooms.map(room => {
      let premium = 0;
      if (room.hasBath) premium += weightBath;
      if (room.hasBalcony) premium += weightBalcony;
      if (room.hasCloset) premium += weightCloset;
      if (room.hasWindow) premium += weightWindow;
      totalPremiumsSum += premium;
      return premium;
    });

    // 2. Base rent remainder
    const baseRentRemainder = Math.max(0, totalRent - totalPremiumsSum);

    // 3. Room sizing parameters
    const totalSize = rooms.reduce((sum, room) => sum + room.size, 0);

    // 4. Calculate individual shares
    let calculatedSplitsSum = 0;
    const roomShares = rooms.map((room, idx) => {
      const sizeRatio = totalSize > 0 ? room.size / totalSize : 0;
      const baseShare = baseRentRemainder * sizeRatio;
      const premiumShare = roomPremiums[idx];
      const totalShare = baseShare + premiumShare;
      calculatedSplitsSum += totalShare;

      return {
        id: room.id,
        name: room.name,
        size: room.size,
        sizePercent: sizeRatio * 100,
        baseShare,
        premiumShare,
        totalShare
      };
    });

    // Adjust for fractional/rounding issues so sum is exactly totalRent
    const diff = totalRent - calculatedSplitsSum;
    if (Math.abs(diff) > 0.001 && roomShares.length > 0) {
      roomShares[0].totalShare += diff;
      roomShares[0].baseShare += diff;
    }

    // Update math summary card details
    summaryTotalRent.textContent = `$${totalRent.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    summaryBaseRent.textContent = `$${baseRentRemainder.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    summaryPremiumRent.textContent = `$${totalPremiumsSum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    
    const actualChecksum = roomShares.reduce((s, r) => s + r.totalShare, 0);
    summaryChecksum.textContent = `$${actualChecksum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

    // Render Detailed Table Rows
    detailedTableBody.innerHTML = '';
    if (roomShares.length === 0) {
      const emptyText = (window as any).t ? (window as any).t('split.empty') : 'No rooms added. Click "+ Add Room" above to begin.';
      detailedTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="px-6 py-8 text-center text-mute font-mono text-xs">
            ${emptyText}
          </td>
        </tr>
      `;
    } else {
      roomShares.forEach(share => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-canvas-soft-2/50 transition-colors';
        row.innerHTML = `
          <td class="px-6 py-4 font-medium text-ink">${share.name}</td>
          <td class="px-6 py-4 text-right font-mono text-xs text-body">${share.size}</td>
          <td class="px-6 py-4 text-right font-mono text-xs text-body">${share.sizePercent.toFixed(1)}%</td>
          <td class="px-6 py-4 text-right font-mono text-xs text-body">$${share.baseShare.toFixed(2)}</td>
          <td class="px-6 py-4 text-right font-mono text-xs text-body">$${share.premiumShare.toFixed(2)}</td>
          <td class="px-6 py-4 text-right font-mono text-sm font-semibold text-link">$${share.totalShare.toFixed(2)}</td>
        `;
        detailedTableBody.appendChild(row);
      });
    }

    // Render Visual Bars Chart
    chartContainer.innerHTML = '';
    if (roomShares.length === 0) {
      const noRecordsText = (window as any).t ? (window as any).t('split.no.records') : 'No records.';
      chartContainer.innerHTML = `
        <div class="text-xs text-mute font-mono py-2">
          ${noRecordsText}
        </div>
      `;
    } else {
      roomShares.forEach((share, idx) => {
        const percentOfRent = totalRent > 0 ? (share.totalShare / totalRent) * 100 : 0;
        const colorClass = `bar-color-${idx % chartColorCount}`;
        
        const chartRow = document.createElement('div');
        chartRow.className = 'space-y-1';
        chartRow.innerHTML = `
          <div class="flex justify-between text-xs font-medium">
            <span class="text-ink truncate max-w-[150px]">${share.name}</span>
            <span class="font-mono" style="color: var(--color-body)">$${share.totalShare.toFixed(2)} (${percentOfRent.toFixed(1)}%)</span>
          </div>
          <div class="w-full h-3 rounded-full overflow-hidden border border-hairline" style="background: var(--color-canvas-soft-2)">
            <div class="h-full rounded-full ${colorClass} transition-all duration-300" style="width: ${percentOfRent}%"></div>
          </div>
        `;
        chartContainer.appendChild(chartRow);
      });
    }
  }

  // Add Room handler
  addRoomBtn?.addEventListener('click', () => {
    const newId = String(Date.now());
    const alphabeticalChar = String.fromCharCode(65 + (rooms.length % 26));
    rooms.push({
      id: newId,
      name: `Bedroom ${alphabeticalChar}`,
      size: 100,
      hasBath: false,
      hasBalcony: false,
      hasCloset: false,
      hasWindow: true
    });
    renderRooms();
    calculateSplits();
  });

  // Attach changes to inputs
  totalRentInput?.addEventListener('input', calculateSplits);
  weightBathInput?.addEventListener('input', calculateSplits);
  weightBalconyInput?.addEventListener('input', calculateSplits);
  weightClosetInput?.addEventListener('input', calculateSplits);
  weightWindowInput?.addEventListener('input', calculateSplits);

  window.addEventListener('locale-changed', () => {
    renderRooms();
    calculateSplits();
  });

  // Initialize
  renderRooms();
  calculateSplits();
</script>

