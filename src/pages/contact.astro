---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us — Fairrentcalc | Rent Split Calculator Support"
  description="Get in touch with the Fairrentcalc team. Report bugs, request features, or ask questions about our rent split calculator, screen calibrator, and listing evaluator."
  canonicalUrl="https://fairrentcalc.com/contact"
>
  <div class="py-12 max-w-3xl mx-auto">
    <div class="mb-12">
      <span class="font-mono text-xs font-semibold text-link uppercase tracking-wider">Support</span>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-display-lg text-ink mt-2">
        Contact Us
      </h1>
      <p class="mt-3 text-body text-base max-w-2xl">
        Have a question, found a bug, or want to suggest a feature? We would love to hear from you.
      </p>
    </div>

    <div class="space-y-10">
      <!-- Contact Methods -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- GitHub -->
        <div class="p-6 bg-canvas border border-hairline rounded-md shadow-level-2">
          <div class="w-10 h-10 rounded-sm bg-ink text-canvas flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold tracking-display-md text-ink mb-2">GitHub</h3>
          <p class="text-sm text-body mb-4">
            Report bugs, request features, or browse the source code. Issues and pull requests are welcome.
          </p>
          <a 
            href="https://github.com/anomalyco/opencode" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-sm font-medium text-link hover:underline inline-flex items-center gap-1"
          >
            Visit GitHub Repository <span>→</span>
          </a>
        </div>

        <!-- Email -->
        <div class="p-6 bg-canvas border border-hairline rounded-md shadow-level-2">
          <div class="w-10 h-10 rounded-sm bg-ink text-canvas flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-semibold tracking-display-md text-ink mb-2">Email</h3>
          <p class="text-sm text-body mb-4">
            For general inquiries, partnership opportunities, or anything else, reach out via email.
          </p>
          <a 
            href="mailto:hello@fairrentcalc.com" 
            class="text-sm font-medium text-link hover:underline inline-flex items-center gap-1"
          >
            hello@fairrentcalc.com <span>→</span>
          </a>
        </div>
      </div>

      <!-- Common Questions -->
      <section>
        <h2 class="text-lg font-semibold tracking-display-md text-ink mb-6 pb-3 border-b border-hairline">
          Common Questions
        </h2>
        <div class="space-y-6 text-sm text-body leading-relaxed">
          <div>
            <h3 class="font-semibold text-ink mb-1">How do I report a bug?</h3>
            <p>
              The fastest way to report a bug is by opening an issue on our <a href="https://github.com/anomalyco/opencode" target="_blank" rel="noopener noreferrer" class="text-link font-medium hover:underline">GitHub repository</a>. Please include the browser you are using, the device type, and steps to reproduce the issue.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-ink mb-1">Can I contribute to the project?</h3>
            <p>
              Yes. Fairrentcalc is open source. Fork the repository, make your changes, and submit a pull request. All contributions are reviewed and appreciated.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-ink mb-1">Is the tool really free?</h3>
            <p>
              Yes, completely. There are no accounts, no subscriptions, no hidden fees, and no paywalls. All calculations run locally in your browser.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-ink mb-1">Do you store my rent data?</h3>
            <p>
              No. All calculations and room configurations are stored only in your browser's local storage. Nothing is ever sent to a server. See our <a href="/privacy" class="text-link font-medium hover:underline">Privacy Policy</a> for details.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
