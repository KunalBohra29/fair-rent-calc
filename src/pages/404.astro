---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | Fairrentcalc"
  description="The page you are looking for does not exist or has been moved."
  canonicalUrl="https://fairrentcalc.com/404"
>
  <section class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <span class="font-mono text-6xl md:text-8xl font-semibold text-hairline-strong select-none">
      404
    </span>
    <h1 class="mt-6 text-2xl md:text-3xl font-semibold tracking-display-lg text-ink">
      Page not found
    </h1>
    <p class="mt-4 text-sm md:text-base text-body max-w-md leading-relaxed">
      The page you are looking for does not exist or has been moved. Check the URL or head back to the homepage.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center gap-3">
      <a
        href="/"
        class="h-10 px-6 flex items-center justify-center bg-primary hover:bg-ink text-on-primary font-medium rounded-pill shadow-level-2 transition-all focus-visible-vercel text-sm"
      >
        Go to Homepage
      </a>
      <a
        href="/split"
        class="h-10 px-6 flex items-center justify-center bg-canvas hover:bg-canvas-soft text-ink font-medium rounded-pill border border-hairline shadow-level-1 transition-all focus-visible-vercel text-sm"
      >
        Open Splitter
      </a>
    </div>
  </section>
</Layout>
