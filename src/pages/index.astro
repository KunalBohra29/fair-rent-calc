---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Fairrentcalc — Rent Split Calculator by Square Footage & Room Size | Free Online Tool"
  description="Use Fairrentcalc, the detailed rent split calculator, to divide roommate rent fairly. Split rent by square footage, room size, and custom amenity weights. The apartment rent split calculator that replaces guesswork with math."
  canonicalUrl="https://fairrentcalc.com"
>
  <!-- Hero Section -->
  <section class="pt-20 pb-16 md:pt-32 md:pb-24 text-center flex flex-col items-center">
    <!-- Announcement Badge -->
    <a href="/calibrate" class="inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full bg-canvas-soft-2 border border-hairline hover:bg-canvas-soft transition-all focus-visible-vercel">
      <span class="font-mono text-[10px] font-semibold uppercase px-1.5 py-0.5 rounded-full bg-link/10 text-link">New</span>
      <span class="text-xs text-body font-medium" data-i18n="hero.badge">Physical Blueprint Calibration is now live. Try it →</span>
    </a>

    <!-- Main Headline -->
    <h1 class="text-4xl md:text-6xl font-semibold tracking-display-xl leading-tight max-w-4xl text-ink" data-i18n="hero.title">
      Rent sharing, mathematically resolved.
    </h1>
    
    <p class="mt-6 text-lg md:text-xl text-body max-w-2xl leading-relaxed" data-i18n="hero.subtitle">
      No more arguments over who has the private bathroom or a bigger room. Calibrate your device's screen to measure floor plans, adjust feature weights, and split rent fairly.
    </p>

    <!-- Hero CTA Buttons -->
    <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
      <a 
        href="/split" 
        class="h-12 px-8 flex items-center justify-center bg-primary hover:bg-ink text-on-primary font-medium rounded-pill shadow-level-3 hover:shadow-level-4 transition-all focus-visible-vercel text-base"
        data-i18n="hero.cta.split"
      >
        Split Roommate Rent
      </a>
      <a 
        href="/calibrate" 
        class="h-12 px-8 flex items-center justify-center bg-canvas hover:bg-canvas-soft text-ink font-medium rounded-pill border border-hairline shadow-level-2 hover:shadow-level-3 transition-all focus-visible-vercel text-base"
        data-i18n="hero.cta.calibrate"
      >
        Calibrate Screen Diagonal
      </a>
    </div>
  </section>

  <!-- Quick Feature Grid -->
  <section class="py-12 border-t border-hairline">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Feature 1: Rent Splitter -->
      <div class="p-8 bg-canvas rounded-md border border-hairline shadow-level-2 hover:shadow-level-3 transition-all group">
        <div class="w-10 h-10 rounded-sm bg-ink text-canvas flex items-center justify-center mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold tracking-display-md text-ink" data-i18n="features.title">Rent Splitter</h3>
        <p class="mt-3 text-sm text-body leading-relaxed" data-i18n="features.split.desc">
          Input room sizes and features. Adjust slider weights for private bathrooms, balconies, or closets. Let the algorithm split rent mathematically.
        </p>
        <div class="mt-6">
          <a href="/split" class="text-sm font-medium text-link hover:underline inline-flex items-center gap-1" data-i18n="features.split.cta">
            Build roommate grid <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- Feature 2: Calibrator -->
      <div class="p-8 bg-canvas rounded-md border border-hairline shadow-level-2 hover:shadow-level-3 transition-all group">
        <div class="w-10 h-10 rounded-sm bg-ink text-canvas flex items-center justify-center mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold tracking-display-md text-ink" data-i18n="features.calibrator.title">Physical Calibrator</h3>
        <p class="mt-3 text-sm text-body leading-relaxed" data-i18n="features.calibrator.desc">
          Use a credit card against your screen to auto-detect your display's PPI and true diagonal. Measures physical blueprint layouts in real-time.
        </p>
        <div class="mt-6">
          <a href="/calibrate" class="text-sm font-medium text-link hover:underline inline-flex items-center gap-1" data-i18n="features.calibrator.cta">
            Calibrate now <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- Feature 3: Evaluator -->
      <div class="p-8 bg-canvas rounded-md border border-hairline shadow-level-2 hover:shadow-level-3 transition-all group">
        <div class="w-10 h-10 rounded-sm bg-ink text-canvas flex items-center justify-center mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold tracking-display-md text-ink" data-i18n="features.evaluator.title">Listing Evaluator</h3>
        <p class="mt-3 text-sm text-body leading-relaxed" data-i18n="features.evaluator.desc">
          Compare listing rent prices against income bounds and local square footage indices. Check if an apartment is a steal or overpriced.
        </p>
        <div class="mt-6">
          <a href="/evaluate" class="text-sm font-medium text-link hover:underline inline-flex items-center gap-1" data-i18n="features.evaluator.cta">
            Evaluate a listing <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Visual Mockup section -->
  <section class="py-16 md:py-24 border-t border-hairline">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="font-mono text-xs font-semibold text-link uppercase tracking-wider" data-i18n="comparison.label">Engineering Focus</span>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-display-lg mt-4 text-ink leading-tight" data-i18n="comparison.title">
          Why standard calculators fail roommate groups.
        </h2>
        <p class="mt-6 text-sm md:text-base text-body leading-relaxed" data-i18n="comparison.p1">
          Legacy tools force arbitrary fixed pricing formulas. They assume a private bathroom is worth exactly the same amount in a cheap flat as in a high-end luxury townhouse.
        </p>
        <p class="mt-4 text-sm md:text-base text-body leading-relaxed">
          <span data-i18n="comparison.p2">With <strong>fairrentcalc.com</strong>, your group dictates the values. Adjust the visual sliders to negotiate the weights. Measure your floor plan to scale directly on screen.</span>
        </p>
      </div>

      <!-- Competitor Table Mockup -->
      <div class="w-full bg-canvas rounded-md border border-hairline shadow-level-4 overflow-hidden">
        <div class="bg-canvas-soft border-b border-hairline px-6 py-4 flex items-center justify-between">
          <span class="font-mono text-xs font-semibold uppercase text-ink" data-i18n="comparison.table">Feature Comparison Matrix</span>
          <span class="flex gap-1">
            <span class="w-2 h-2 rounded-full bg-error"></span>
            <span class="w-2 h-2 rounded-full bg-warning"></span>
            <span class="w-2 h-2 rounded-full bg-link"></span>
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-hairline bg-canvas-soft-2 font-mono text-[11px] text-hairline-strong uppercase">
                <th class="px-6 py-3 font-semibold" data-i18n="comparison.header.feature">Feature Capabilities</th>
                <th class="px-6 py-3 font-semibold" data-i18n="comparison.header.splitwise">Splitwise</th>
                <th class="px-6 py-3 font-semibold" data-i18n="comparison.header.cribapp">Cribapp</th>
                <th class="px-6 py-3 font-semibold text-link" data-i18n="comparison.header.frc">FairRentCalc</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline text-sm tabular-nums">
              <tr>
                <td class="px-6 py-3.5 font-medium text-ink" data-i18n="comparison.row1">Custom Feature Weights</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no">No (Fixed)</td>
                <td class="px-6 py-3.5 text-mute" data-i18n="comparison.na">N/A</td>
                <td class="px-6 py-3.5 text-link font-semibold" data-i18n="comparison.yes.sliders">Yes (Sliders)</td>
              </tr>
              <tr>
                <td class="px-6 py-3.5 font-medium text-ink" data-i18n="comparison.row2">Screen Size Auto-Detect</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no.simple">No</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no.simple">No</td>
                <td class="px-6 py-3.5 text-link font-semibold" data-i18n="comparison.yes.simple">Yes</td>
              </tr>
              <tr>
                <td class="px-6 py-3.5 font-medium text-ink" data-i18n="comparison.row3">Physical Blueprint Scale</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no.simple">No</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no.simple">No</td>
                <td class="px-6 py-3.5 text-link font-semibold" data-i18n="comparison.yes.card">Yes (Credit Card)</td>
              </tr>
              <tr>
                <td class="px-6 py-3.5 font-medium text-ink" data-i18n="comparison.row4">Rent-to-Income Index</td>
                <td class="px-6 py-3.5 text-error font-medium" data-i18n="comparison.no.simple">No</td>
                <td class="px-6 py-3.5 text-link" data-i18n="comparison.basic">Yes (Basic)</td>
                <td class="px-6 py-3.5 text-link font-semibold" data-i18n="comparison.yes.dynamic">Yes (Dynamic)</td>
              </tr>
              <tr>
                <td class="px-6 py-3.5 font-medium text-ink" data-i18n="comparison.row5">SEO / Load Speed (MPA)</td>
                <td class="px-6 py-3.5 text-body" data-i18n="comparison.avg">Average</td>
                <td class="px-6 py-3.5 text-body" data-i18n="comparison.slow">Slow</td>
                <td class="px-6 py-3.5 text-link font-semibold" data-i18n="comparison.instant">Instant (Astro)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="py-16 md:py-24 border-t border-hairline">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-display-lg text-ink mb-8">
        The Fairrentcalc Rent Split Calculator — How It Works
      </h2>

      <div class="space-y-6 text-sm md:text-base text-body leading-relaxed">
        <p>
          Splitting rent among roommates is one of the most common sources of conflict in shared housing. Traditional methods like dividing the total rent equally ignore the real differences between rooms. A roommate with a private bathroom, a larger bedroom, and a walk-in closet pays the same as someone in a smaller room with shared facilities. That is not fair, and it is why <strong>Fairrentcalc</strong> was built — as a detailed rent split calculator that uses math, not arguments, to divide costs.
        </p>

        <p>
          Fairrentcalc is a rent split calculator by square footage that lets each roommate input their room dimensions, toggle which amenities they have, and adjust weight sliders to reflect how much each feature is worth. The algorithm then calculates each person's fair share of the total rent in real time. Whether you need a rent split calculator based on room size, a rent split calculator by room, or a full apartment rent split calculator for a four-bedroom unit, this tool handles it all.
        </p>

        <h3 class="text-lg font-semibold tracking-display-md text-ink pt-4">
          Why a Square Footage-Based Rent Split Calculator Matters
        </h3>

        <p>
          When roommates split rent by square footage, the分配 becomes proportional to the space each person occupies. A bedroom that is 180 square feet costs more than one that is 100 square feet — and that makes sense. But square footage alone does not tell the whole story. Fairrentcalc goes further by letting you add amenity premiums on top of the base square footage calculation. Does one roommate have a private balcony? A walk-in closet? Oversized windows with natural light? Each of these features carries a premium, and the sliders let your group negotiate exactly how much each one is worth.
        </p>

        <p>
          This is what makes Fairrentcalc a truly detailed rent split calculator. Unlike basic tools that simply divide rent by the number of roommates, this calculator accounts for room size, room features, and custom weighting — giving you a precise, mathematically sound breakdown of who pays what. The split rent calculator by room displays a visual bar chart and a detailed table so every roommate can see exactly how their share was calculated, with full transparency.
        </p>

        <h3 class="text-lg font-semibold tracking-display-md text-ink pt-4">
          Screen Calibration for Physical Blueprint Measurement
        </h3>

        <p>
          One of the features that sets Fairrentcalc apart from any other rent split calculator square footage tool is the built-in physical calibrator. Using a standard credit card placed against your screen, the tool auto-detects your display's pixels per inch (PPI) and true diagonal size. Once calibrated, you can lay a floor plan blueprint directly on your screen and measure room dimensions to scale. This means you do not need to guess room sizes — you can measure them physically from a printed or digital blueprint, making the rent split calculator by room even more accurate.
        </p>

        <h3 class="text-lg font-semibold tracking-display-md text-ink pt-4">
          Evaluate Listing Prices Before You Commit
        </h3>

        <p>
          Beyond splitting rent, Fairrentcalc includes a listing evaluator that checks whether an apartment is fairly priced for its area. Input the listing rent, square footage, and location tier, and the tool compares the price against local market averages. It also evaluates rent affordability based on your combined group income using the 30% rule and the 50/30/20 budgeting framework. This turns Fairrentcalc from a simple rent split calculator into a complete apartment decision-making tool.
        </p>

        <h3 class="text-lg font-semibold tracking-display-md text-ink pt-4">
          Built for Roommates, Free to Use
        </h3>

        <p>
          Fairrentcalc is a free, open-source apartment rent split calculator that requires no login, no account, and no download. It works instantly in your browser on any device. The tool supports multiple languages and adapts to dark and light modes. Whether you are moving in with one roommate or four, Fairrentcalc gives you a fair, transparent, and mathematically grounded way to split rent — so you can focus on living together instead of arguing about money.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24 border-t border-hairline">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-semibold tracking-display-lg text-ink mb-4">
        Frequently Asked Questions
      </h2>
      <p class="text-sm text-body mb-10">
        Answers to common questions about splitting rent, dividing costs fairly, and using the Fairrentcalc rent split calculator.
      </p>

      <div class="space-y-4">

        <!-- FAQ 1 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">How to split rent by square footage calculator?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              To split rent by square footage, enter each roommate's room size in the <a href="/split" class="text-link font-medium hover:underline">Rent Split Calculator</a>. The tool divides the base rent proportionally based on how many square feet each room occupies. A 180 sq ft master bedroom will naturally cost more than a 100 sq ft secondary room. You can also layer on amenity premiums — such as private bathrooms, balconies, and walk-in closets — using the weight sliders to get a fully customized and mathematically fair breakdown.
            </p>
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">How to split rent based on income calculator?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              Fairrentcalc's <a href="/evaluate" class="text-link font-medium hover:underline">Listing Evaluator</a> includes an income-based affordability check. Enter your combined group gross monthly income and the listed rent. The tool applies the 30% rule to calculate safe, stretched, and high-risk rent thresholds. It also provides a 50/30/20 monthly budget breakdown so your group can see exactly how rent impacts essentials, wants, and savings. This helps you decide whether a listing fits your income before you commit.
            </p>
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">How to split rent with roommates calculator?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              Use the <a href="/split" class="text-link font-medium hover:underline">Rent Split Calculator</a> to add each roommate as a separate room entry. Input the room name, square footage, and toggle which amenities apply (private bathroom, balcony, closet, windows). Adjust the global amenity weight sliders to set premium percentages. The calculator updates in real time, showing each roommate's share as a visual bar chart and in a detailed breakdown table. No login or account is needed — just open the tool and start calculating.
            </p>
          </div>
        </details>

        <!-- FAQ 4 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">Does rent increase 10% or 5%?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              Rent increases vary by market, location, and landlord policy. In many U.S. markets, annual rent increases typically range from 3% to 10%, with 5% being a common midpoint and 10% occurring in high-demand areas. Some jurisdictions cap annual increases (for example, California's AB 1482 limits most increases to 5% plus local inflation, up to 10%). Fairrentcalc's <a href="/evaluate" class="text-link font-medium hover:underline">Listing Evaluator</a> helps you assess whether a listed rent — including any recent increase — is fair compared to local square footage rates and your income.
            </p>
          </div>
        </details>

        <!-- FAQ 5 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">How to divide rent fairly?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              The fairest way to divide rent is to base each roommate's share on the actual space and features they get. Equal splitting ignores that a master bedroom with a private bathroom is objectively more valuable than a small room with shared facilities. Fairrentcalc divides rent by square footage and lets you add custom amenity premiums using adjustable weight sliders. This means the person with the biggest room and the most perks pays proportionally more — and every roommate can see the exact math behind their share in the detailed breakdown table.
            </p>
          </div>
        </details>

        <!-- FAQ 6 -->
        <details class="group bg-canvas border border-hairline rounded-md shadow-level-2 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none hover:bg-canvas-soft transition-colors">
            <h3 class="text-sm md:text-base font-semibold text-ink pr-4">How can I calculate rent?</h3>
            <span class="shrink-0 w-6 h-6 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center text-mute group-open:rotate-45 transition-transform">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            </span>
          </summary>
          <div class="px-6 pb-5 text-sm text-body leading-relaxed border-t border-hairline">
            <p class="pt-4">
              To calculate rent, start with the total monthly rent and the square footage of each room. Divide each room's square footage by the total square footage to get a size ratio, then multiply the base rent by that ratio. Add any amenity premiums for features like private bathrooms or balconies. Fairrentcalc automates this entire process — just enter your total rent, room sizes, and feature toggles, and the <a href="/split" class="text-link font-medium hover:underline">Rent Split Calculator</a> instantly shows each roommate's exact share with a visual chart and detailed table.
            </p>
          </div>
        </details>

      </div>
    </div>
  </section>

  <!-- Final Call to Action -->
  <section class="py-16 text-center border-t border-hairline relative">
    <div class="absolute inset-0 blur-3xl pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(121, 40, 202, 0.05) 0%, transparent 70%);"></div>
    <h2 class="text-3xl font-semibold tracking-display-lg text-ink" data-i18n="cta.title">
      Ready to make renting fair?
    </h2>
    <p class="mt-4 text-sm text-body max-w-md mx-auto leading-relaxed" data-i18n="cta.subtitle">
      Choose a tool below to run your calculations immediately. No login required.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a 
        href="/split" 
        class="h-10 px-6 flex items-center justify-center bg-primary hover:bg-ink text-on-primary font-medium rounded-pill shadow-level-2 transition-all"
        data-i18n="cta.open.split"
      >
        Open Splitter
